#!/usr/bin/env python3
"""
plc_response_test.py
Measures how quickly an OpenPLC program responds to a REAL button press
by physically monitoring the LED output line.
"""
import RPi.GPIO as GPIO
import time
import csv
import statistics
from datetime import datetime

# --- Configuration ---
BUTTON_PIN = 17       # GPIO17, Pin 11 — read-only, same pin OpenPLC reads
MONITOR_PIN = 24      # GPIO24, Pin 18 — monitors the LED output line
NUM_SAMPLES = 50
OUTPUT_FILE = "plc_latency_results.csv"
TIMEOUT_S = 5.0

# --- Setup ---
GPIO.setmode(GPIO.BCM)
GPIO.setup(BUTTON_PIN, GPIO.IN)     # READ only — do not drive this pin
GPIO.setup(MONITOR_PIN, GPIO.IN)

results = []

print()
print("=" * 52)
print("  OpenPLC Response Time Test (real button)")
print(f"  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
print("=" * 52)
print(f"  Button  : GPIO{BUTTON_PIN}  (Pin 11)")
print(f"  Monitor : GPIO{MONITOR_PIN}  (Pin 18)")
print(f"  Samples : {NUM_SAMPLES}")
print(f"  Output  : {OUTPUT_FILE}")
print("-" * 52)
print(f"  Physically press the button {NUM_SAMPLES} times.")
print("  Wait for the LED to turn off between each press.")
print()

i = 0
while i < NUM_SAMPLES:
    input(f"[{i+1:3d}/{NUM_SAMPLES:3d}]  Ready — press the button now...")

    # Wait for the real button to go HIGH (press)
    press_deadline = time.perf_counter() + TIMEOUT_S
    while GPIO.input(BUTTON_PIN) == GPIO.LOW:
        if time.perf_counter() > press_deadline:
            print("  [no press detected — try again]")
            break
    else:
        t0 = time.perf_counter()

        # Wait for LED to turn on
        deadline = t0 + TIMEOUT_S
        led_on = False
        while time.perf_counter() < deadline:
            if GPIO.input(MONITOR_PIN) == GPIO.HIGH:
                t1 = time.perf_counter()
                led_on = True
                break

        if not led_on:
            print("  [timeout waiting for LED — skipping]")
            continue

        latency_ms = (t1 - t0) * 1000
        print(f"  {latency_ms:.3f} ms")
        results.append(latency_ms)

        # Wait for LED to turn off before next press
        while GPIO.input(MONITOR_PIN) == GPIO.HIGH:
            time.sleep(0.001)
        i += 1
        continue

    continue

GPIO.cleanup()

# --- Summary ---
print()
print("=" * 52)
print(f"  Results  ({len(results)} samples)")
print("-" * 52)
if results:
    print(f"  Min      : {min(results):8.3f} ms")
    print(f"  Max      : {max(results):8.3f} ms")
    print(f"  Mean     : {statistics.mean(results):8.3f} ms")
    print(f"  Median   : {statistics.median(results):8.3f} ms")
    if len(results) > 1:
        print(f"  Std dev  : {statistics.stdev(results):8.3f} ms")
    sorted_results = sorted(results)
    p95 = sorted_results[int(0.95 * len(sorted_results)) - 1]
    print(f"  95th pct : {p95:8.3f} ms")
print("=" * 52)
print()

with open(OUTPUT_FILE, "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["sample", "latency_ms"])
    for idx, val in enumerate(results, start=1):
        writer.writerow([idx, f"{val:.3f}"])
print(f"Results saved to {OUTPUT_FILE}")
